    {
      "parameters": {
        "jsCode": "// Keep only rows that still need a transcript (transcript cell empty).\n// Trim each row down to video_id + url so the loop stays light.\nreturn $input.all().filter(i => {\n  const j = i.json;\n  if (!j.video_id) return false;\n  const t = (j.transcript == null ? '' : String(j.transcript)).trim();\n  return t.length === 0;\n}).map(i => {\n  const j = i.json;\n  const url = (j.url && String(j.url).startsWith('http')) ? String(j.url) : ('https://www.youtube.com/watch?v=' + j.video_id);\n  return { json: { video_id: j.video_id, url } };\n});"
      },
      "id": "b04",
      "name": "Filter Need Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "b05",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [620, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/{{ $('Config').first().json.apify_actor }}/run-sync-get-dataset-items?token={{ $('Config').first().json.apify_token }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"videoUrl\": \"{{ $json.url }}\"\n}",
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "b06",
      "name": "Apify Transcript",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [840, 180],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Parse Apify response, pair with current looped row (batchSize 1).\n// Decide whether a Supadata fallback is needed (only if Apify came up empty\n// AND a Supadata key is configured).\nconst apify = $input.all();\nconst src = $('Loop Over Items').all();\nconst cfg = $('Config').first().json;\nconst key = cfg.supadata_api_key || '';\nconst keyOk = key && key !== 'REPLACE_WITH_SUPADATA_API_KEY';\nconst out = [];\nfor (let i = 0; i < apify.length; i++) {\n  const meta = (src[i] && src[i].json) || (src[0] && src[0].json) || {};\n  const raw = apify[i].json;\n  let chunks = [];\n  if (Array.isArray(raw)) chunks = raw;\n  else if (raw && Array.isArray(raw.data)) chunks = raw.data;\n  else if (raw && Array.isArray(raw.transcript)) chunks = raw.transcript;\n  else if (raw && Array.isArray(raw.body)) chunks = raw.body;\n  const text = chunks.map(c => typeof c === 'string' ? c : (c && (c.text || c.transcript || c.snippet) || '')).filter(Boolean).join(' ').trim();\n  const ok = text.length > 100;\n  out.push({ json: {\n    video_id: meta.video_id || '',\n    url: meta.url || ('https://www.youtube.com/watch?v=' + (meta.video_id || '')),\n    transcript: ok ? text.slice(0, 49000) : '',\n    transcript_status: ok ? 'ok' : 'no_transcript',\n    transcript_length: text.length,\n    source: ok ? 'apify' : '',\n    do_fallback: (!ok) && keyOk\n  }});\n}\nreturn out;"
      },
      "id": "b07",
      "name": "Parse Apify Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1040, 180]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-fallback",
              "leftValue": "={{ $json.do_fallback }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b08",
      "name": "Need Fallback?",
      "type": "n8n-nodes-base.if",
