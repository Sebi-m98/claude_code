    {
      "parameters": {
        "jsCode": "// Keep only rows that still need a transcript (transcript cell empty).\n// Trim each row down to video_id + url so the loop stays light.\nreturn $input.all().filter(i => {\n  const j = i.json;\n  if (!j.video_id) return false;\n  const t = (j.transcript == null ? '' : String(j.transcript)).trim();\n  return t.length === 0;\n}).map(i => {\n  const j = i.json;\n  const url = (j.url && String(j.url).startsWith('http')) ? String(j.url) : ('https://www.youtube.com/watch?v=' + j.video_id);\n  return { json: { video_id: j.video_id, url } };\n});"
      },
      "id": "b04",
      "name": "Filter Need Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [400, 300]
    },
    {
      "parameters": {
        "batchSize": 1,
        "options": {}
      },
      "id": "b05",
      "name": "Loop Over Items",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [620, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.apify.com/v2/acts/{{ $('Config').first().json.apify_actor }}/run-sync-get-dataset-items?token={{ $('Config').first().json.apify_token }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"videoUrl\": \"{{ $json.url }}\"\n}",
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "b06",
      "name": "Apify Transcript",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [860, 200],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Pair the Apify response with the current looped row (batchSize 1).\nconst apify = $input.all();\nconst src = $('Loop Over Items').all();\nconst out = [];\nfor (let i = 0; i < apify.length; i++) {\n  const meta = (src[i] && src[i].json) || (src[0] && src[0].json) || {};\n  const raw = apify[i].json;\n  let chunks = [];\n  if (Array.isArray(raw)) chunks = raw;\n  else if (raw && Array.isArray(raw.data)) chunks = raw.data;\n  else if (raw && Array.isArray(raw.transcript)) chunks = raw.transcript;\n  else if (raw && Array.isArray(raw.body)) chunks = raw.body;\n  const text = chunks.map(c => typeof c === 'string' ? c : (c && (c.text || c.transcript || c.snippet) || '')).filter(Boolean).join(' ').trim();\n  const status = text.length > 100 ? 'ok' : 'no_transcript';\n  out.push({ json: { video_id: meta.video_id || '', transcript: text.slice(0, 49000), transcript_status: status, transcript_length: text.length } });\n}\nreturn out;"
      },
      "id": "b07",
      "name": "Parse Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1080, 200]
