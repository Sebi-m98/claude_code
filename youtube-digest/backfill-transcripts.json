    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.supadata.ai/v1/youtube/transcript?text=true&url={{ encodeURIComponent($json.url) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-api-key",
              "value": "={{ $('Config').first().json.supadata_api_key }}"
