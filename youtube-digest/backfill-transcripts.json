      "id": "b09",
      "name": "Supadata Transcript",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1460, 80],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// Parse Supadata response; if it found text use it, otherwise keep the\n// (empty) Apify result so the row is still written as no_transcript.\nconst meta = $('Parse Apify Transcript').first().json;\nconst resp = ($input.first() && $input.first().json) || {};\nlet text = '';\nif (typeof resp.content === 'string') text = resp.content;\nelse if (Array.isArray(resp.content)) text = resp.content.map(c => typeof c === 'string' ? c : (c && c.text) || '').filter(Boolean).join(' ');\nelse if (typeof resp.transcript === 'string') text = resp.transcript;\ntext = (text || '').trim();\nconst ok = text.length > 100;\nreturn [{ json: {\n  video_id: meta.video_id,\n  url: meta.url,\n  transcript: ok ? text.slice(0, 49000) : (meta.transcript || ''),\n  transcript_status: ok ? 'ok' : (meta.transcript_status || 'no_transcript'),\n  source: ok ? 'supadata' : (meta.source || '')\n}}];"
      },
      "id": "b10",
      "name": "Parse Supadata Transcript",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1660, 80]
