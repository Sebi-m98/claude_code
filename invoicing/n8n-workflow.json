        "url": "=https://api.easybill.de/rest/v1/documents/{{ $('easybill: Create Draft Invoice').item.json.id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {"name": "Content-Type", "value": "application/json"}
