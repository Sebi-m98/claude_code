        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"document_file_attachment_ids\": [{{ $('easybill: Upload Toggl PDF').item.json.id }}]\n}",
        "options": {}
      },
      "id": "node-eb-link",
      "name": "easybill: Link Attachment",
      "type": "n8n-nodes-base.httpRequest",
