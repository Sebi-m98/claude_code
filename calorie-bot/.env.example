# Telegram bot token vom BotFather (siehe README)
TELEGRAM_BOT_TOKEN=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Google Sheets ID (aus der URL deines Sheets, der lange String zwischen /d/ und /edit)
GOOGLE_SHEETS_ID=

# Pfad zur Service-Account JSON-Datei (siehe README)
GOOGLE_CREDENTIALS_PATH=./credentials.json

# Optional: Erlaubte Telegram User IDs (kommagetrennt). Leer = jeder darf den Bot benutzen.
# Eigene User ID bekommst du z.B. von @userinfobot in Telegram.
ALLOWED_USER_IDS=
